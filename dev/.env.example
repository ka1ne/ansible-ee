# Copy to .env in the REPOSITORY ROOT and fill in. The Makefile auto-loads it.
#   cp dev/.env.example .env
# .env is gitignored — never commit real credentials.

# ── Windows target ──────────────────────────────────────────────────────────
# Host the EE connects to over WinRM. Leave WINRM_HOST unset to fall back to
# host.containers.internal, which reaches the machine running the container.
# WINRM_HOST=192.168.1.50
WINRM_USER=ansible
WINRM_PASSWORD=

# ── SQL Server ──────────────────────────────────────────────────────────────
# The SA password for the throwaway SQL Server container started by
# dev/scripts/run-local.sh. Must satisfy SQL complexity rules: 8+ characters
# with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=

# The address the WINDOWS host uses to reach SQL Server. When the container
# runs on the same machine you are targeting, the loopback address is correct
# because Docker publishes port 1433 to the host.
MSSQL_HOST=127.0.0.1

# ── Image ───────────────────────────────────────────────────────────────────
IMAGE_NAME=ghcr.io/ka1ne/ansible-ee
# IMAGE_TAG defaults to the current git short SHA; the local harness uses
# 'latest' unless you override it here.
# IMAGE_TAG=latest

# ── EE base image (optional) ────────────────────────────────────────────────
# Point at an internal mirror for air-gapped builds. If you switch to a minimal
# base image, also change package_manager_path in ee/execution-environment.yml
# to /usr/bin/microdnf.
# EE_BASE_IMAGE=registry.access.redhat.com/ubi9:latest

# ── Galaxy mirror (optional) ────────────────────────────────────────────────
# Leave blank to pull collections from public galaxy.ansible.com.
GALAXY_MIRROR_URL=
GALAXY_MIRROR_TOKEN=

# ── AWX (optional) ──────────────────────────────────────────────────────────
# Used by the configuration-as-code targets once #10 lands.
CONTROLLER_HOST=http://localhost:30080
CONTROLLER_USERNAME=admin
CONTROLLER_PASSWORD=

# ── Testing against a Windows VM on your network ────────────────────────────
# Used by `make test-vm` / dev/scripts/run-tests.sh. No VM is provisioned —
# these point at a machine you already have.
#
# TEST_HOST accepts an IP address or a hostname.
TEST_HOST=
TEST_USER=ansible
TEST_PASSWORD=

# ntlm (workgroup/local accounts) | credssp (domain, second hop) |
# kerberos (domain) | basic (dev only)
TEST_TRANSPORT=ntlm
TEST_SCHEME=http
TEST_PORT=5985

# Port the IIS test site binds to. Chosen to stay out of the way of anything
# already listening on 80/443 on a shared lab box.
TEST_IIS_PORT=18080

# SQL Server instance to target, and whether the role may install its
# PowerShell prerequisites (SqlServerDsc, dbatools) from PSGallery. Off by
# default — it mutates the machine, which is rude on a shared VM.
TEST_MSSQL_INSTANCE=MSSQLSERVER
TEST_MSSQL_PREREQS=false
