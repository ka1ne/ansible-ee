# ── PoC environment variables ─────────────────────────────────────────────────
# Copy to .env and fill in real values — .env is gitignored

# Windows host WinRM credentials
# The PoC targets YOUR Windows 11 machine via host.containers.internal.
# Use a local admin account (the one you created with setup-winrm-local.ps1).
WINRM_USER=ansible-poc
WINRM_PASSWORD=changeme123!

# SQL Server 2022 (Linux container — mcr.microsoft.com/mssql/server:2022-latest)
# SA password must meet SQL complexity: ≥8 chars, upper, lower, digit, symbol
MSSQL_SA_PASSWORD=YourStr0ng!Passw0rd

# The hostname Ansible uses to reach MSSQL from WITHIN the Podman network.
# Default "mssql" matches the container name in run-poc.sh.
MSSQL_HOST=mssql
