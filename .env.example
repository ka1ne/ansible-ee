# .env.example — copy to .env and fill in values
# The Makefile auto-loads .env if present (never commit .env)
#
# Minimum required to bootstrap:
#   GALAXY_MIRROR_URL + GALAXY_MIRROR_TOKEN  (to pull collections)
#   IMAGE_NAME                               (target registry)
#
# For molecule mssql:   MOLECULE_TEST_HOST + ANSIBLE_WINRM_USER + ANSIBLE_WINRM_PASSWORD
# For molecule init:    nothing extra — defaults work out of the box

# ── Registry ────────────────────────────────────────────────────────────────
IMAGE_NAME=ghcr.io/ka1ne/ansible-ee
# IMAGE_TAG defaults to the current git short SHA (see Makefile)

# ── EE base image (optional — defaults to public ubi9 full) ──────────────────
# Switch to a private mirror for air-gapped CI (also change package_manager_path
# in execution-environment.yml to /usr/bin/microdnf for the minimal image):
# EE_BASE_IMAGE=ghcr.io/ka1ne/ee-minimal-rhel9:latest

# ── Galaxy mirror (optional — leave blank to use public galaxy.ansible.com) ──
GALAXY_MIRROR_URL=
GALAXY_MIRROR_TOKEN=

# ── Molecule: winrm-local scenario (WSL2 → Windows host) ────────────────────
# WIN_HOST auto-detected from /etc/resolv.conf; override if needed.
# WIN_HOST=10.255.255.254
WIN_USER=Administrator
WIN_PASSWORD=

# ── Molecule: winrm-ping scenario (dockur/windows — Linux CI with /dev/kvm) ──
# WIN_PASSWORD is the local admin password set inside the Windows container.
# WIN_PASSWORD=Molecule1!
# WIN_IMAGE=ghcr.io/dockur/windows   # uncomment to mirror to a private registry

# ── AWX (local) ──────────────────────────────────────────────────────────────
# After running 'make awx-install', get the token from the AWX UI:
#   Settings → Users → admin → Tokens → Add
AWX_HOST=http://localhost:30080
AWX_TOKEN=

# ── Molecule: mssql scenario (pre-existing SQL Server host) ──────────────────
MOLECULE_TEST_HOST=
ANSIBLE_WINRM_USER=
ANSIBLE_WINRM_PASSWORD=
