{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deployment Manifest",
  "description": "Schema for manifests generated by the React capability selector UI",
  "type": "object",
  "required": ["capabilities", "target_hosts", "env"],
  "properties": {
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "iis",
          "sqlserver",
          "dotnet",
          "windows_baseline",
          "linux_baseline"
        ]
      },
      "description": "List of capabilities to deploy"
    },
    "target_hosts": {
      "type": "string",
      "minLength": 1,
      "description": "Ansible host pattern — group name or comma-separated hosts"
    },
    "env": {
      "type": "string",
      "enum": ["dev", "staging", "prod"]
    },
    "change_id": {
      "type": "string",
      "pattern": "^CHG[0-9]{7,}$",
      "description": "ServiceNow change request number. Required for prod."
    },
    "iis_config": {
      "type": "object",
      "properties": {
        "site_name": { "type": "string" },
        "app_pool": { "type": "string" },
        "dotnet_version": { "type": "string" },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["protocol", "port"],
            "properties": {
              "protocol": { "type": "string", "enum": ["http", "https"] },
              "port": { "type": "integer" },
              "hostname": { "type": "string" },
              "cert_thumbprint": { "type": "string" }
            }
          }
        }
      }
    },
    "sqlserver_config": {
      "type": "object",
      "properties": {
        "instance_name": { "type": "string" },
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "recovery_model": { "type": "string", "enum": ["FULL", "SIMPLE", "BULK_LOGGED"] },
              "collation": { "type": "string" }
            }
          }
        }
      }
    },
    "dotnet_config": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "deploy_path": { "type": "string" },
        "artifact_source": { "type": "string", "format": "uri" }
      }
    }
  },
  "if": {
    "properties": { "env": { "const": "prod" } }
  },
  "then": {
    "required": ["change_id"]
  }
}
